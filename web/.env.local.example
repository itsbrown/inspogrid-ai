# Supabase — create a project at https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# App URL (for auth redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Extension legacy shared key (optional, for dev fallback only).
# Primary auth for Phase 1.2+ is the logged-in Supabase session via /api/extension/session + Bearer token.
EXTENSION_API_KEY=dev-extension-key-change-in-production