{
  "manifest_version": 3,
  "name": "InspoGrid AI",
  "version": "0.2.0",
  "description": "Send saved Pinterest boards to InspoGrid AI for print-ready contact-sheet mood boards.",
  "permissions": ["activeTab", "storage", "cookies", "scripting"],
  "host_permissions": [
    "https://www.pinterest.com/*",
    "https://pinterest.com/*",
    "http://localhost:3000/*",
    "https://*.supabase.co/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Send to InspoGrid"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.pinterest.com/*", "https://pinterest.com/*"],
      "js": ["content-scripts/pinterest.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}